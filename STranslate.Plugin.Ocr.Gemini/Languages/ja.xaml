<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Url">URL</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Url_Description">Gemini API サービスアドレスを設定します&#x0a;インターフェース API アドレスには Path を入力しないでください。明確な意図がある場合を除きます。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_ApiKey">APIキー</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_ApiKey_Placeholder">APIキーを入力してください</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_ApiKey_Description">Gemini API キーを入力してください</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Model">モデルを選択</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Prompt_Header">プロンプト設定</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Prompt_Description">翻訳に使用するプロンプトテンプレートを選択または編集します</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Prompt_Placeholder">プロンプトテンプレートを選択</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_EditPrompt_ToolTip">プロンプトを編集</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_EditPrompt_Content">編集</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Temperature">温度制御</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_Temperature_Description">モデル出力のランダム性を制御します</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_ThinkingBudget">思考バジェット</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Ocr.Gemini_ThinkingBudget_Description">モデルの思考バジェットを制限します&#x0a;-1 で自動、0 で無効、正の整数で最大思考バジェット（トークン数）を指定します。</sys:String>

</ResourceDictionary>
